generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
// ---------------------------------------
model User {
  id            String    @id @default(uuid())
  nome_completo String
  telefone      Int       @unique
  senha         String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  Session       Session[]

  // Campos para imagens
  imagem_perfil    String?
  imagem_bi_frente String?
  imagem_bi_verso  String?
  Kixikila         Kixikila[]
  UsuarioKixikila  UsuarioKixikila[]
  Convidado        Convidado[] // Relacionamento com os convites
  ContaBancaria    ContaBancaria?
  Carteira         Carteira?

  @@map("usuarios")
}
// ---------------------------------------
model Session {
  id        String    @id @default(uuid()) // Identificador único da sessão
  userId    String // Relacionamento com o usuário logado (agora String)
  user      User      @relation(fields: [userId], references: [id]) // Chave estrangeira para o modelo User
  createdAt DateTime  @default(now()) // Data de criação da sessão
  expired   Boolean   @default(false) // Indica se a sessão está expirada
  expiresAt DateTime? // Data de expiração (opcional, caso queira sessões temporárias)

  @@map("sessoes")
}
// ---------------------------------------
model Kixikila {
  id              String      @id @default(uuid())
  grupo           String
  valor           Int
  limiteDeMembros Int
  adminId         String      // ID do usuário que criou a Kixikila
  inicio          DateTime
  frequencia      Frequencias

  // Relacionamentos
  admin       User                @relation(fields: [adminId], references: [id])
  membros     UsuarioKixikila[]
  convidados  Convidado[]

  @@map("kixikilas")
}
// ---------------------------------------
model UsuarioKixikila {
  id          String @id @default(uuid())
  id_kixikila String
  usuarioId   String // Referencia o ID (String) do User

  // Relacionamentos
  kixikila Kixikila @relation(fields: [id_kixikila], references: [id])
  usuario  User     @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, id_kixikila])
}
// ---------------------------------------
model ContaBancaria {
  id              String  @id @default(uuid())
  iban            BigInt
  ordenante       String
  usuarioId       String  @unique() // Garante o relacionamento um-para-um (agora String)
  userAgreedTerms Boolean

  usuario User @relation(fields: [usuarioId], references: [id])

  @@map("contas_bancarias")
}
// ---------------------------------------
model Carteira {
  id        String   @id @default(uuid())
  cartao    BigInt // 18 dígitos, pode usar BigInt
  saldo     Int      @default(0)
  validoAte DateTime
  usuarioId String   @unique() // Garante o relacionamento um-para-um (agora String)

  usuario User @relation(fields: [usuarioId], references: [id])

  @@map("carteiras")
}

enum Frequencias {
  DIARIA
  SEMANAL
  QUINZENAL
  MENSAL
  ANUAL
}
// ---------------------------------------
model Convidado {
  id               String    @id @default(uuid())
  kixikilaId       String    // Referência ao grupo Kixikila
  usuarioId        String    // Referência ao usuário convidado
  conviteEnviadoPor String    // ID do usuário que enviou o convite
  status           Status    @default(PENDENTE)
  dataConvite      DateTime  @default(now()) // Registro da data de envio

  // Relacionamentos
  kixikila Kixikila @relation(fields: [kixikilaId], references: [id])
  convidador User  @relation(fields: [conviteEnviadoPor], references: [id]) // Quem enviou o convite

  @@unique([kixikilaId, usuarioId]) // Um usuário só pode ser convidado uma vez por grupo
  @@map("convidados")
}

enum Status {
  APROVADO
  PENDENTE
  NEGADO
}